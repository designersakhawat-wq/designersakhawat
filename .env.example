# Environment Variables Template
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=portfolio_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# ─────────────────────────────────────────────
# SESSION / AUTH
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# One-time setup token for creating first admin account
# Set to a strong random string, then clear after first use
ADMIN_SETUP_TOKEN=change_me_to_a_secret_token

# ─────────────────────────────────────────────
# MEDIA STORAGE
# ─────────────────────────────────────────────
# Absolute path to persistent uploads directory
# LOCAL: ./uploads  (relative to project root)
# PRODUCTION: /home/youruser/uploads  (or Hostinger persistent disk path)
UPLOAD_DIR=./uploads

# Maximum upload size in MB
MAX_UPLOAD_MB=50

# ─────────────────────────────────────────────
# EMAIL / SMTP (optional - inquiries still saved to DB if not configured)
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
NOTIFICATION_EMAIL=designersakhawat86@gmail.com

# ─────────────────────────────────────────────
# SITE
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rate limiting (requests per window)
RATE_LIMIT_CONTACT=3
RATE_LIMIT_LOGIN=5
